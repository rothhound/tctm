# Server
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Auth (single-tenant)
# Generate hash: node -e "require('bcryptjs').hash('your-password',10).then(h=>console.log(h))"
JWT_SECRET=change-me-to-a-random-64-byte-string
AUTH_PASSWORD_HASH=$2a$10$placeholder

# Partner identity (used in extraction prompt)
PARTNER_NAME="Jane Doe"
PARTNER_ROLE="Managing Partner at Sequoia Capital"

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/assistant

# Redis (BullMQ)
# Local: use HOST/PORT. Heroku: REDIS_URL is set automatically by the addon.
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Slack
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=xoxb-...
PARTNER_SLACK_USER_ID=U0123456789
SLACK_TASK_REACTION=dart

# Google (Gmail + Drive)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_PUBSUB_VERIFICATION_TOKEN=
GMAIL_USER_EMAIL=partner@firm.com
GMAIL_PUBSUB_TOPIC=projects/your-gcp-project/topics/gmail-push

# Notion
NOTION_API_KEY=
NOTION_VERIFICATION_TOKEN=

# Granola
GRANOLA_API_KEY=

# Web Push (VAPID)
# Generate keys: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Heroku sets DATABASE_URL and REDIS_URL automatically via addons.
# All other config vars are set via: heroku config:set KEY=VALUE
