# Server
NODE_ENV=development
PORT=4100                                   # API port (TCTM uses 4100/3100 to avoid clashing with other local apps)
LOG_LEVEL=info
# CORS allowed origin — defaults to "*" if unset. In production set to your web origin.
CORS_ORIGIN=

# Auth (single-tenant, Google Sign-In)
# JWT_SECRET signs the access token issued after Google verification.
JWT_SECRET=change-me-to-a-random-64-byte-string

# The single email allowed to sign in. Case-insensitive match.
ALLOWED_GOOGLE_EMAIL=partner@example.com

# Partner identity (used in the extraction prompt AND for Slack passive-capture anchoring)
PARTNER_NAME="Jane Doe"
PARTNER_ROLE="Managing Partner at Sequoia Capital"
# Other names the partner is addressed by in Slack (comma-separated, case-insensitive, word-boundary
# matched). A passive channel message naming the partner — even without an @tag — is captured.
# Leave empty if there are none. Avoid short/ambiguous tokens (e.g. "GM" collides with "good morning").
PARTNER_ALIASES=

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/assistant

# Redis (BullMQ)
# Local: use HOST/PORT. Heroku: REDIS_URL is set automatically by the addon.
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ── LLM provider ─────────────────────────────────────────────────────────────
# Which backend powers extraction / judge / classification. Swap with this one var —
# no code changes. Only the ACTIVE provider needs a key; the other can stay blank.
LLM_PROVIDER=anthropic                      # anthropic | openai

# Anthropic (active when LLM_PROVIDER=anthropic). Models are fixed in code (shared/anthropic.module).
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (active when LLM_PROVIDER=openai). Models are overridable to match your account's access.
# Cost logging is best-effort: known models are priced, others log as 0.
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL_EXTRACTOR=gpt-4o               # high-quality extraction + calibration analysis
OPENAI_MODEL_JUDGE=gpt-4o-mini              # cheap adversarial QC
OPENAI_MODEL_CLASSIFIER=gpt-4o-mini         # snooze / waiting-on quick classification

# Slack — the bot must be a MEMBER of each channel it should read. Three capture paths:
#   1. @tctm mention   → explicit capture, PARTNER ONLY (gated on PARTNER_SLACK_USER_ID)
#   2. 🎯 reaction      → explicit capture, PARTNER ONLY (emoji = SLACK_TASK_REACTION)
#   3. passive message  → captured only when it anchors on the partner (@tag, name/alias, or a
#                         thread the partner is in) and is from someone else.
# Bot-token event subscriptions needed: app_mention, reaction_added, message.channels.
# OAuth scopes: app_mentions:read, channels:history, groups:history, reactions:read,
#   users:read, users:read.email, channels:read, groups:read.
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=xoxb-...
PARTNER_SLACK_USER_ID=U0123456789
SLACK_TASK_REACTION=dart

# Google OAuth client ID — used for BOTH Sign-In (ID-token verification) and Gmail/Drive scopes.
# Create a "Web application" OAuth client; authorize http://localhost:3100 + the production origin.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_PUBSUB_TOPIC=projects/your-gcp-project/topics/gmail-push
# Gmail auth — set ONE mode:
#  (A) Domain-wide delegation (recommended for a shared mailbox): a service account impersonates
#      the mailbox. GMAIL_SERVICE_ACCOUNT_KEY = service-account JSON, raw or base64 (base64 is easier for config
#      vars). Workspace admin grants the SA gmail.readonly via Admin → Security → API controls →
#      Domain-wide delegation. GMAIL_IMPERSONATE_SUBJECT = the mailbox to read as.
GMAIL_SERVICE_ACCOUNT_KEY=
GMAIL_IMPERSONATE_SUBJECT=tasks@yourfirm.com
#  (B) Single-user OAuth refresh token (fallback): scope gmail.readonly, access_type=offline,
#      obtained once via the OAuth Playground/a script.
GMAIL_REFRESH_TOKEN=

# Notion (webhook-based; the verification token is issued when you create the webhook)
NOTION_VERIFICATION_TOKEN=
# Notion user ID of the partner — used for @mention / assignment detection
PARTNER_NOTION_USER_ID=

# Granola — key (grn_…) from the desktop app: Settings → Connectors → API keys.
GRANOLA_API_KEY=
# Optional base URL override; defaults to https://public-api.granola.ai/v1
GRANOLA_API_BASE=

# Web Push (VAPID)
# Generate keys: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Heroku sets DATABASE_URL and REDIS_URL automatically via addons.
# All other config vars are set via: heroku config:set KEY=VALUE
